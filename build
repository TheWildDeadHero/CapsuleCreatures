#!/bin/sh
# Builds the engine with one of its CMake presets (engine/CMakePresets.json; build folder engine/build/<preset>),
# then, with --test, runs that preset's tests. With --game FOLDER it builds that game instead (a folder with
# reference/project.json, such as one the Studio's New game made): the engine library and the game only, with the
# same preset, in FOLDER/build/<preset>/ (the engine's CAPSULE_GAMES; its own tests and apps are left out).
. "$(dirname "$0")/scripts/common.sh"
## The preset when none is given.
default_preset=desktop-debug
preset=""
run_tests=0
game=""
want_game=0
for arg in "$@"; do
   if [ "$want_game" -eq 1 ]; then
      game=$arg
      want_game=0
      continue
   fi
   case "$arg" in
      -h|--help)
         echo "usage: ./build [PRESET] [--test] [--game FOLDER]"
         echo "Configures and builds engine/ with a CMake preset (default: $default_preset); --test runs its ctest"
         echo "preset afterwards (desktop-debug, windows-debug, headless and big-endian-check have one)."
         echo "--game FOLDER builds that game (FOLDER/reference/project.json) with the preset instead, into"
         echo "FOLDER/build/PRESET/ (capsule_<name>, and capsule_<name>.gba on the GBA)."
         echo "Presets: desktop-debug desktop-release windows-debug windows-release headless big-endian-check"
         echo "         gba-debug gba-release dc-debug dc-release"
         exit 0
         ;;
      --test) run_tests=1 ;;
      --game) want_game=1 ;;
      -*)
         echo "error: unknown option: $arg (try --help)" >&2
         exit 2
         ;;
      *) preset=$arg ;;
   esac
done
if [ "$want_game" -eq 1 ]; then
   echo "error: --game needs the game's folder (try --help)" >&2
   exit 2
fi
need_submodule engine CMakePresets.json
preset=${preset:-$default_preset}
if [ -z "$game" ]; then
   cd "$engine" || exit 1
   cmake --preset "$preset" || exit 1
   cmake --build --preset "$preset" || exit 1
   if [ "$run_tests" -eq 1 ]; then
      ctest --preset "$preset" || exit 1
   fi
   exit 0
fi

# A game: its folder made absolute (CMake reads it from the engine's folder), its own build folder.
if [ "$run_tests" -eq 1 ]; then
   echo "error: --test runs the engine's tests; a --game build has none" >&2
   exit 2
fi
case "$preset" in
   headless|big-endian-check)
      echo "error: the $preset preset builds no games; pick a desktop, windows, gba or dc preset" >&2
      exit 2
      ;;
esac
if [ ! -f "$game/reference/project.json" ]; then
   echo "error: $game is not a game folder (it has no reference/project.json)" >&2
   exit 1
fi
if [ -n "${MSYSTEM:-}" ]; then
   game=$(cd "$game" && pwd -W) || exit 1   # MSYS2: C:/... for Windows' CMake, not /c/...
else
   game=$(cd "$game" && pwd) || exit 1
fi
out="$game/build/$preset"
# A desktop build reuses the SDL2 source the engine's own build of the preset downloaded, if there is one.
sdl2_source="$engine/build/$preset/_deps/sdl2-src"
set --
if [ -f "$sdl2_source/CMakeLists.txt" ]; then
   set -- "-DFETCHCONTENT_SOURCE_DIR_SDL2=$sdl2_source"
fi
cd "$engine" || exit 1
cmake --preset "$preset" -B "$out" -DCAPSULE_GAMES="$game" -DCAPSULE_ENGINE_TESTS=OFF "$@" || exit 1
cmake --build "$out" || exit 1
echo "built $game in $out"
